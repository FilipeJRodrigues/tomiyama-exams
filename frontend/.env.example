# Copie para .env.local (fora do git) e preencha.
# Com VITE_USE_MOCKS=true o MSW simula a API e o login; os demais valores podem ficar vazios.
# Sem VITE_USE_MOCKS, o padrão é true em `npm run dev` e false em `npm run build`.
VITE_USE_MOCKS=true

# URL base da HTTP API (saída da stack SAM), sem barra no fim.
VITE_API_URL=

# Cognito (saídas da stack SAM). Não são segredos, mas não versione valores reais.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
